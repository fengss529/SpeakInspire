  与界面主色一致，但向亮处提一档——
  深色纯色在图标群里太沉，渐变能在小尺寸下把白色声波"托"出来。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#6750A4" />
                <item android:offset="1" android:color="#8B6FC7" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
